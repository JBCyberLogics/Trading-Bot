[Unit]
Description=SMC ICT Trading Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/darkage/Desktop/Bot
Environment="PATH=/home/darkage/Desktop/Bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="WINEPREFIX=/home/darkage/.mt5"
ExecStartPre=/home/darkage/Desktop/Bot/venv/bin/python /home/darkage/Desktop/Bot/scripts/validate_for_live.py --quick
ExecStart=/home/darkage/Desktop/Bot/venv/bin/python /home/darkage/Desktop/Bot/scripts/live_deploy.py
ExecStop=/bin/kill -SIGINT $MAINPID
ExecReload=/bin/kill -SIGUSR1 $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/darkage/Desktop/Bot/logs/service.log
StandardError=append:/home/darkage/Desktop/Bot/logs/service.error.log

[Install]
WantedBy=multi-user.target
