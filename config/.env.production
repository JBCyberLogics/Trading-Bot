# Production environment variables
# SENSITIVE VALUES CLEARED FOR SECURITY

BOT_ENV=production

# MT5 Credentials
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
WINEPREFIX=
MT5_TERMINAL_PATH=
MT5_WINE_PATH=

# ZeroMQ Ports
ZMQ_HOST=127.0.0.1
ZMQ_PYTHON_PORT=5555
ZMQ_MT5_PORT=5556
ZMQ_LIVE_PORT=5557

# Database
DB_PATH=
DB_BACKUP_PATH=

# API Keys
NEWS_API_KEY=
NEWS_API_ENDPOINT=
NEWS_RAPIDAPI_HOST=
NEWS_RAPIDAPI_APP=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring
PROMETHEUS_PORT=9090
HEALTH_CHECK_PORT=8080

# Backup (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
