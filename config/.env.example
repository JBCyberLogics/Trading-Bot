# MT5 Credentials
MT5_LOGIN="YOUR_MT5_LOGIN"
MT5_PASSWORD="YOUR_MT5_PASSWORD"
MT5_SERVER="YOUR_MT5_SERVER"

# Wine/MT5 Paths
WINEPREFIX="/home/yourusername/.mt5"
# Windows path for MT5 terminal (used by Wine Python)
MT5_TERMINAL_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
# Linux path to terminal (handy for shell scripts)
MT5_WINE_PATH="/home/yourusername/.mt5/drive_c/Program Files/MetaTrader 5/terminal64.exe"

# ZeroMQ Ports
ZMQ_HOST=127.0.0.1
ZMQ_PYTHON_PORT=5555
ZMQ_MT5_PORT=5556
ZMQ_LIVE_PORT=5557

# Database
DB_PATH=database/live_trades.db

# Bot Settings
BOT_ENV=development
LOG_LEVEL=INFO

# News feed
NEWS_API_KEY=YOUR_RAPIDAPI_KEY
NEWS_API_ENDPOINT=YOUR_NEWS_API_ENDPOINT
NEWS_RAPIDAPI_HOST=YOUR_RAPIDAPI_HOST
NEWS_RAPIDAPI_APP=YOUR_RAPIDAPI_APP

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring
HEALTH_CHECK_PORT=8080
PROMETHEUS_PORT=9090
