//@version=6
strategy("H4_Level_Engine v2.0.0", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ----------------------------
// Inputs: Instrument / Engine
// ----------------------------
instrument_type = input.string("forex", "Instrument Type", options=["forex", "metal", "index", "crypto"])
tick_size_input = input.float(0.0, "Tick Size Override (0 = Symbol Min Tick)", minval=0.0, step=0.00001)
volatility_factor = input.float(1.0, "Volatility Factor", minval=0.1, step=0.1)

atr_period = input.int(14, "ATR Period", minval=1)
atr_multiplier = input.float(1.0, "ATR Multiplier", minval=0.1, step=0.1)

// ----------------------------
// Inputs: Structure (Hybrid)
// ----------------------------
internal_lookback = input.int(4, "Internal Lookback", minval=3, maxval=5)
external_lookback = input.int(10, "External Lookback", minval=10)
internal_break_factor = input.float(0.05, "Internal Break Distance (ATR factor)", minval=0.0, step=0.01)
external_break_factor = input.float(0.10, "External Break Distance (ATR factor)", minval=0.0, step=0.01)
confirmation_window_bars = input.int(12, "Internal->External Confirmation Window", minval=1)

// ----------------------------
// Inputs: BOS / Displacement
// ----------------------------
keep_recent_bos = input.int(2, "Keep Recent BOS", minval=1)
min_disp_range_factor = input.float(1.5, "Min Displacement Candle Range (ATR factor)", minval=0.1, step=0.1)
min_consecutive_candles = input.int(2, "Min Consecutive Displacement Candles", minval=1)

// ----------------------------
// Inputs: Order Blocks
// ----------------------------
ob_min_size_factor = input.float(0.5, "OB Min Size (ATR factor)", minval=0.0, step=0.1)
ob_bos_required = input.bool(true, "OB Requires BOS Link")
ob_max_active_zones = input.int(2, "OB Max Active Zones Per Direction", minval=1)
strict_mitigation_close_required = input.bool(true, "OB Strict Mitigation (Close Inside Required)")
wick_only_marks_tested = input.bool(true, "Wick-only Touch Marks Tested (Volatile Pairs)")
tested_persists = input.bool(true, "Tested State Persists")
remove_mitigated_ob = input.bool(true, "Remove Mitigated OB")

// ----------------------------
// Inputs: Liquidity
// ----------------------------
eq_tolerance_factor = input.float(0.05, "Equal High/Low Tolerance (ATR factor)", minval=0.0, step=0.01)
min_liquidity_touches = input.int(2, "Min Equal High/Low Touches", minval=2)
rank_equal_weight = input.float(1.0, "Liquidity Rank Weight: Equal High/Low", minval=0.0, step=0.1)
rank_pdh_pdl_weight = input.float(0.8, "Liquidity Rank Weight: PDH/PDL", minval=0.0, step=0.1)
rank_isolated_weight = input.float(0.6, "Liquidity Rank Weight: Isolated Swing", minval=0.0, step=0.1)

// ----------------------------
// Inputs: Range / Cleanup
// ----------------------------
equilibrium_ratio = input.float(0.5, "Equilibrium Ratio", minval=0.1, maxval=0.9, step=0.05)
remove_weak_structure = input.bool(true, "Remove Weak Structure")

// ----------------------------
// Inputs: H1 Execution Engine
// ----------------------------
exec_group = "H1 Execution Engine"
exec_enabled = input.bool(true, "Enable H1 Execution Engine", group=exec_group)
exec_timeframe = input.timeframe("60", "Execution Timeframe", group=exec_group)
exec_pivot_len = input.int(3, "H1 Pivot Length", minval=1, maxval=10, group=exec_group)
exec_show_signals = input.bool(true, "Show Execution Signals", group=exec_group)
exec_allow_range = input.bool(true, "Allow Range Strategy", group=exec_group)

// ----------------------------
// Inputs: Inducement / Performance
// ----------------------------
inducement_enabled = input.bool(true, "Enable Inducement Layer")
inducement_source = input.string("internal_swings", "Inducement Source", options=["internal_swings"])
inducement_sweep_factor = input.float(0.02, "Inducement Sweep Tolerance (ATR factor)", minval=0.0, step=0.01)
require_sweep_before_ob_touch = input.bool(true, "Require Sweep Before OB Touch")

bos_decay_tau = input.float(20.0, "BOS Decay Tau", minval=1.0, step=1.0)
exhaustion_window = input.int(3, "Exhaustion Window (bars)", minval=1)
exhaustion_extension_factor = input.float(0.5, "Exhaustion Extension (ATR factor)", minval=0.1, step=0.1)
exhaustion_penalty_factor = input.float(0.3, "Exhaustion Penalty", minval=0.0, maxval=1.0, step=0.05)

// ----------------------------
// Inputs: Lux-like Visual Pack
// ----------------------------
lx_group_smart = "Lux Visual - Smart Money"
lx_group_internal = "Lux Visual - Internal Structure"
lx_group_swing = "Lux Visual - Swing Structure"
lx_group_blocks = "Lux Visual - Order Blocks"
lx_group_equal = "Lux Visual - EQH/EQL"
lx_group_gaps = "Lux Visual - Fair Value Gaps"
lx_group_levels = "Lux Visual - Highs & Lows MTF"
lx_group_zones = "Lux Visual - Premium/Discount"

lx_visual_pack_enabled = input.bool(true, "Enable Lux-like Visual Engine", group=lx_group_smart)
lx_mode_input = input.string("Present", "Mode", options=["Historical", "Present"], group=lx_group_smart)
lx_style_input = input.string("Colored", "Style", options=["Colored", "Monochrome"], group=lx_group_smart)
lx_color_candles_input = input.bool(false, "Color Candles", group=lx_group_smart)

lx_show_internals_input = input.bool(true, "Show Internal Structure", group=lx_group_internal)
lx_show_internal_bull_input = input.string("All", "Bullish Structure", options=["All", "BOS", "CHoCH"], group=lx_group_internal, inline="lxibull")
lx_internal_bull_color_input = input.color(#089981, "", group=lx_group_internal, inline="lxibull")
lx_show_internal_bear_input = input.string("All", "Bearish Structure", options=["All", "BOS", "CHoCH"], group=lx_group_internal, inline="lxibear")
lx_internal_bear_color_input = input.color(#F23645, "", group=lx_group_internal, inline="lxibear")
lx_internal_structure_size_input = input.string("Tiny", "Internal Label Size", options=["Tiny", "Small", "Normal"], group=lx_group_internal)

lx_show_swing_structure_input = input.bool(true, "Show Swing Structure", group=lx_group_swing)
lx_show_swing_bull_input = input.string("All", "Bullish Structure", options=["All", "BOS", "CHoCH"], group=lx_group_swing, inline="lxbull")
lx_swing_bull_color_input = input.color(#089981, "", group=lx_group_swing, inline="lxbull")
lx_show_swing_bear_input = input.string("All", "Bearish Structure", options=["All", "BOS", "CHoCH"], group=lx_group_swing, inline="lxbear")
lx_swing_bear_color_input = input.color(#F23645, "", group=lx_group_swing, inline="lxbear")
lx_swing_structure_size_input = input.string("Small", "Swing Label Size", options=["Tiny", "Small", "Normal"], group=lx_group_swing)
lx_show_swings_input = input.bool(false, "Show Swing Points", group=lx_group_swing, inline="lxsw")
lx_swings_length_input = input.int(50, "", minval=10, group=lx_group_swing, inline="lxsw")
lx_show_strong_weak_hl_input = input.bool(true, "Show Strong/Weak High/Low", group=lx_group_swing)

lx_show_internal_ob_input = input.bool(true, "Internal Order Blocks", group=lx_group_blocks, inline="lxiob")
lx_internal_ob_size_input = input.int(5, "", minval=1, maxval=20, group=lx_group_blocks, inline="lxiob")
lx_show_swing_ob_input = input.bool(true, "Swing Order Blocks", group=lx_group_blocks, inline="lxsob")
lx_swing_ob_size_input = input.int(5, "", minval=1, maxval=20, group=lx_group_blocks, inline="lxsob")
lx_ob_filter_input = input.string("Atr", "Order Block Filter", options=["Atr", "Cumulative Mean Range"], group=lx_group_blocks)
lx_ob_mitigation_input = input.string("High/Low", "Order Block Mitigation", options=["Close", "High/Low"], group=lx_group_blocks)
lx_internal_bull_ob_color = input.color(color.new(#3179f5, 80), "Internal Bullish OB", group=lx_group_blocks)
lx_internal_bear_ob_color = input.color(color.new(#f77c80, 80), "Internal Bearish OB", group=lx_group_blocks)
lx_swing_bull_ob_color = input.color(color.new(#1848cc, 80), "Bullish OB", group=lx_group_blocks)
lx_swing_bear_ob_color = input.color(color.new(#b22833, 80), "Bearish OB", group=lx_group_blocks)

lx_show_equal_hl_input = input.bool(true, "Equal High/Low", group=lx_group_equal)
lx_equal_length_input = input.int(3, "Bars Confirmation", minval=1, group=lx_group_equal)
lx_equal_threshold_input = input.float(0.1, "Threshold", minval=0.0, maxval=0.5, step=0.1, group=lx_group_equal)
lx_equal_size_input = input.string("Tiny", "Label Size", options=["Tiny", "Small", "Normal"], group=lx_group_equal)

lx_show_fvg_input = input.bool(false, "Fair Value Gaps", group=lx_group_gaps)
lx_fvg_auto_threshold_input = input.bool(true, "Auto Threshold", group=lx_group_gaps)
lx_fvg_tf_input = input.timeframe("", "Timeframe", group=lx_group_gaps)
lx_fvg_bull_color_input = input.color(color.new(#00ff68, 70), "Bullish FVG", group=lx_group_gaps)
lx_fvg_bear_color_input = input.color(color.new(#ff0008, 70), "Bearish FVG", group=lx_group_gaps)
lx_fvg_extend_input = input.int(1, "Extend FVG", minval=0, group=lx_group_gaps)

lx_show_daily_levels_input = input.bool(false, "Daily", group=lx_group_levels, inline="lxd")
lx_daily_style_input = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=lx_group_levels, inline="lxd")
lx_daily_color_input = input.color(#2157f3, "", group=lx_group_levels, inline="lxd")
lx_show_weekly_levels_input = input.bool(false, "Weekly", group=lx_group_levels, inline="lxw")
lx_weekly_style_input = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=lx_group_levels, inline="lxw")
lx_weekly_color_input = input.color(#2157f3, "", group=lx_group_levels, inline="lxw")
lx_show_monthly_levels_input = input.bool(false, "Monthly", group=lx_group_levels, inline="lxm")
lx_monthly_style_input = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=lx_group_levels, inline="lxm")
lx_monthly_color_input = input.color(#2157f3, "", group=lx_group_levels, inline="lxm")

lx_show_pd_zones_input = input.bool(false, "Premium/Discount Zones", group=lx_group_zones)
lx_premium_zone_color_input = input.color(#F23645, "Premium Zone", group=lx_group_zones)
lx_equilibrium_zone_color_input = input.color(#878b94, "Equilibrium Zone", group=lx_group_zones)
lx_discount_zone_color_input = input.color(#089981, "Discount Zone", group=lx_group_zones)

// ----------------------------
// Visual Upgrade (from config)
// ----------------------------
vu_max_ob_objects = 20
vu_max_structure_labels = 15
vu_max_liquidity_levels = 20
vu_reuse_existing_objects = true
vu_delete_on_refresh = false

vu_bias_panel_enabled = not lx_visual_pack_enabled
vu_panel_bg_transp = 85

vu_show_hh_hl_lh_ll = not lx_visual_pack_enabled
vu_show_bos = not lx_visual_pack_enabled
vu_show_choch = not lx_visual_pack_enabled
vu_structure_offset_above = 5
vu_structure_offset_below = 5
vu_structure_line_width = 1

vu_order_blocks_enabled = not lx_visual_pack_enabled
vu_ob_min_strength_threshold = 0.6
vu_max_ob_display = 10
vu_ob_border_width = 1
vu_ob_fill_untested = 85
vu_ob_fill_tested = 90
vu_ob_fill_invalidated = 95
vu_ob_extend_right = true

vu_liquidity_enabled = not lx_visual_pack_enabled
vu_show_equal_highs = not lx_visual_pack_enabled
vu_show_equal_lows = not lx_visual_pack_enabled
vu_show_pdh_pdl = not lx_visual_pack_enabled
vu_liq_line_width = 1
vu_fade_taken_liquidity = true

vu_inducement_enabled = not lx_visual_pack_enabled
vu_show_sweeps = not lx_visual_pack_enabled
vu_show_idm = not lx_visual_pack_enabled

vu_clean_mode_enabled = true
vu_hide_overlap = true
vu_hide_excess_objects = true

vu_col_bull = lx_visual_pack_enabled ? (lx_style_input == "Monochrome" ? #b2b5be : #089981) : color.green
vu_col_bear = lx_visual_pack_enabled ? (lx_style_input == "Monochrome" ? #5d606b : #F23645) : color.red
vu_col_neutral = lx_visual_pack_enabled ? #878b94 : color.gray
vu_col_liq_equal = lx_visual_pack_enabled ? (lx_style_input == "Monochrome" ? #878b94 : color.orange) : color.orange
vu_col_liq_pdh_pdl = lx_visual_pack_enabled ? #2157f3 : color.blue
vu_col_liq_taken = lx_visual_pack_enabled ? #878b94 : color.gray
vu_col_idm = lx_visual_pack_enabled ? #878b94 : color.yellow

// ----------------------------
// Helpers
// ----------------------------
f_clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

f_dir_from_candle(_open, _close) =>
    _close > _open ? 1 : _close < _open ? -1 : 0

f_safe_div(num, den) =>
    den == 0.0 ? 0.0 : num / den

f_liq_rank_name(rankCode) =>
    rankCode == 1 ? "equal_high_low" : rankCode == 2 ? "pdh_pdl" : rankCode == 3 ? "isolated_swing" : "none"

f_remove_ob(idx, obTypeArr, obHighArr, obLowArr, obOriginBarArr, obMitigatedArr, obLinkedArr, obTestedArr, obStrengthArr, obStateArr, obIdmLevelArr, obIdmRequiredArr, obIdmSweptArr, obBoxesArr) =>
    if array.size(obBoxesArr) > idx
        obx = array.get(obBoxesArr, idx)
        if not na(obx)
            box.delete(obx)
        array.remove(obBoxesArr, idx)
    array.remove(obTypeArr, idx)
    array.remove(obHighArr, idx)
    array.remove(obLowArr, idx)
    array.remove(obOriginBarArr, idx)
    array.remove(obMitigatedArr, idx)
    array.remove(obLinkedArr, idx)
    array.remove(obTestedArr, idx)
    array.remove(obStrengthArr, idx)
    array.remove(obStateArr, idx)
    array.remove(obIdmLevelArr, idx)
    array.remove(obIdmRequiredArr, idx)
    array.remove(obIdmSweptArr, idx)

f_count_active_by_dir(dir, obTypeArr, obMitigatedArr, obLinkedArr) =>
    cnt = 0
    if array.size(obTypeArr) > 0
        for i = 0 to array.size(obTypeArr) - 1
            t = array.get(obTypeArr, i)
            m = array.get(obMitigatedArr, i)
            l = array.get(obLinkedArr, i)
            if t == dir and not m and l
                cnt += 1
    cnt

f_is_volatile_symbol(_instrumentType) =>
    tickerUpper = str.upper(syminfo.ticker)
    _instrumentType == "crypto" or str.contains(tickerUpper, "XAU")

f_lx_label_size(sizeText) =>
    sizeText == "Tiny" ? size.tiny : sizeText == "Small" ? size.small : size.normal

f_lx_line_style(styleText) =>
    styleText == "Dashed" ? line.style_dashed : styleText == "Dotted" ? line.style_dotted : line.style_solid

f_lx_show_side(showMode, isChoch) =>
    showMode == "All" or (showMode == "BOS" and not isChoch) or (showMode == "CHoCH" and isChoch)

f_lx_remove_ob(idx, obBiasArr, obHighArr, obLowArr, obTimeArr, obBoxArr) =>
    if array.size(obBoxArr) > idx
        obx = array.get(obBoxArr, idx)
        if not na(obx)
            box.delete(obx)
        array.remove(obBoxArr, idx)
    array.remove(obBiasArr, idx)
    array.remove(obHighArr, idx)
    array.remove(obLowArr, idx)
    array.remove(obTimeArr, idx)

f_lx_remove_fvg(idx, fvgTopArr, fvgBottomArr, fvgBiasArr, fvgTopBoxArr, fvgBottomBoxArr) =>
    if array.size(fvgTopBoxArr) > idx
        bxTop = array.get(fvgTopBoxArr, idx)
        if not na(bxTop)
            box.delete(bxTop)
        array.remove(fvgTopBoxArr, idx)
    if array.size(fvgBottomBoxArr) > idx
        bxBottom = array.get(fvgBottomBoxArr, idx)
        if not na(bxBottom)
            box.delete(bxBottom)
        array.remove(fvgBottomBoxArr, idx)
    array.remove(fvgTopArr, idx)
    array.remove(fvgBottomArr, idx)
    array.remove(fvgBiasArr, idx)

f_lx_is_higher_tf(tf) =>
    timeframe.in_seconds() > timeframe.in_seconds(tf)

// ----------------------------
// Core derived values
// ----------------------------
atr_raw = ta.atr(atr_period)
atr_eff = atr_raw * atr_multiplier * volatility_factor
atr_sma_50 = ta.sma(atr_raw, 50)
atr_ratio = f_safe_div(atr_raw, atr_sma_50)
tick_size = tick_size_input > 0.0 ? tick_size_input : syminfo.mintick

internal_break_dist = atr_eff * internal_break_factor
external_break_dist = atr_eff * external_break_factor
min_disp_range = atr_eff * min_disp_range_factor
ob_min_size = atr_eff * ob_min_size_factor
eq_tolerance = atr_eff * eq_tolerance_factor
inducement_sweep_tol = atr_eff * inducement_sweep_factor
exhaustion_extension = atr_eff * exhaustion_extension_factor
liquidity_near_threshold = atr_eff * 0.2

symbol_volatile = f_is_volatile_symbol(instrument_type)

lx_ob_volatility_measure = lx_ob_filter_input == "Atr" ? ta.atr(200) : f_safe_div(ta.cum(ta.tr), math.max(1, bar_index))
lx_high_volatility_bar = (high - low) >= (2.0 * lx_ob_volatility_measure)
lx_parsed_high = lx_high_volatility_bar ? low : high
lx_parsed_low = lx_high_volatility_bar ? high : low

